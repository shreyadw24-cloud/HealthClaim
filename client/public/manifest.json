{
  "manifest_version": 3,
  "name": "HealthClaim",
  "version": "0.1.0",
  "description": "Verify health claims where they appear.",
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://www.threads.net/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting", "tabCapture", "offscreen"],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ]
}