{
  "manifest_version": 3,
  "name": "HealthClaim",
  "version": "0.1.0",
  "description": "Verify health claims where they appear.",
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:3000/*"]
}